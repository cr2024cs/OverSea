# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不会提交
SECRET_KEY=change-this-to-a-long-random-string
# 可选：覆盖默认 SQLite 路径，例如 postgresql://user:pass@host/db
# DATABASE_URL=

# AI 网关（DeepSeek / 兼容 OpenAI 接口）
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=
AI_TIMEOUT=60
AI_STREAM_DELAY_MS=10

MAX_UPLOAD_BYTES=52428800
MANAGEMENT_FEE_RATE=0.175
TOKEN_TTL_DAYS=14
JWT_EXPIRES_HOURS=12
